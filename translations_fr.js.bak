  "Cadet Pledge": "Cadet Engagement",
  "Cadet Quest Map — Level 2 (Air Cadet)": "Carte De Quête Des Cadets — Niveau 2 (Cadet De L'air)",
  "Cadet Quest Map — Phase 2 (Sea Cadet)": "Carte De Quête Des Cadets — Phase 2 (Cadet Maritime)",
  "Cadet Quest Map — Red Star (Army Cadet)": "Carte De Quête Des Cadets — Etoile Rouge (Cadet De L'armée)",
  "Cadet Quest Map — Training Campus": "Carte De Quête Des Cadets — Formation Campus",
  "Cadet Rank Overview": "Cadet Grade Aperçu",
  "Cadet Rank Structure & Forms of Address": "Structure des grades des cadets et formes d'adresse",
  "Cadet Rating": "Évaluation du cadet",
  "Cadet Recruit": "Cadet Recrue",
