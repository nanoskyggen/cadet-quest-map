  "Range Exam Passed! +50 XP": "Gamme Examen Réussi! +50 PE",
  "Range Instructor Cadet": "Gamme Instructeur Cadet",
  "Range Log": "Gamme Journal",
  "Range Qualification": "Gamme Qualification",
  "Range Recruit": "Gamme Recrue",
  "Range SOP": "Gamme SOP",
