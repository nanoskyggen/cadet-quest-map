  "YANG-KEY": "YANG-CLE",
  "YEAR 1 DRESS PHASE": "ANNÉE 1 TENUE PHASE",
  "YEAR 1 DRILL PHASE": "ANNÉE 1 EXERCICE PHASE",
  "YEAR 1 FIRST AID PHASE": "ANNÉE 1 PREMIERS SECOURS PHASE",
